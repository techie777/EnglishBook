rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Vocabulary Content Bank: Public read-only, write denied to all client users
    match /vocabWords/{wordId} {
      allow read: if true;
      allow write: if false;
    }

    // User profiles: Only authenticated user can read and write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User progress subcollection: Only the user can read/write their word progress
      match /progress/{wordId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
